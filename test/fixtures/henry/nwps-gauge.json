    "impacts": [
      {
        "stage": 32.5,
        "statement": "Illinois Route 18 in Marshall County is closed. Parts of Illinois Route 17 between Sparland and Lacon are closed."
      },
      {
        "stage": 32,
        "statement": "Water begins flooding parts of Illinois Route 18 between Henry and Illinois Route 26. Parts of Illinois Route 17 begin to flood."
      },
      {
        "stage": 30.5,
        "statement": "The Marina building is flooded. Inundation from Waterworks Park on Cromwell Drive toward old grain elevator location on Water Street."
      },
      {
        "stage": 29.6,
        "statement": "A few homes begin to flood in Henry."
      },
      {
        "stage": 28.5,
        "statement": "Hennepin levee overtopped."
      },
      {
        "stage": 28,
        "statement": "Flooding begins to affect buildings east of Illinois Route 29 in Sparland."
      },
      {
        "stage": 23,
        "statement": "Water begins to affect the marina in Henry along with minor flooding of land adjacent to the river."
      }
    ]
